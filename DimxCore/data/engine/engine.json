{
    "engine": {
        // Update rate the engine falls back to outside live mode - on mobile it
        // keeps running with no screen attached. In live mode the display paces
        // the loop instead.
        "idle_fps": 5
    },

    "threads": {
        "max_threads": 10
    },

    "resource_interface": {
        "update_interval_sec": 1.0,
        "request_timeout_sec": 5.0,
        "local": {
            "data_path": ""
        },
        "remote": {
            "files_host": "https://files.dimx.world",
            "default_generic_service": {
                "ws_url": "ws://generic-01.dimx.world:8000",
                "wss_url": "wss://generic-01.dimx.world:8001"
            },
            // The environment the default generic is one of, as a page names its environment
            // (`gateway_service`): a page handing over another of production's generics leaves
            // the socket where it is, one on another gateway moves it (Settings::remoteBackend).
            "default_gateway_service": "https://gateway.dimx.world:5001"
        },
        "cache": {
            "?enabled": [
                { "condition": {"type": "platform", "value": "Web"}, "value": false },
                { "condition": "", "value": true }
            ],
            "max_mb": 1024,
            // The localization sessions recorded on the device (SessionStore, <cache>/sessions):
            // kept under this budget until the user sends or discards them, the oldest going first.
            "sessions_mb": 256
        }
    },


    "?display": [
        {
            "condition": {"type": "platform", "value": "Desktop"},
            "value": {"width": 1280, "height": 720}
        },
        {
            "condition": {"type": "platform", "value": "Mobile"},
            "value": {"width": 432, "height": 888}
        },
        {
            "condition": {"type": "platform", "value": "MagicLeap"},
            "value": {"width": 1280, "height": 960}
        }
    ],

    "device_ar": {
    },

    "live_view_cover": {
        "file": "textures/live-view-cover.gif",
        "background": "0 0 0 1",
        "size": 0.5,
        "fade_seconds": 0.25
    },

    "device_camera": {
        "enabled": true,
        "world_entity": "cam-plane",
        "texture_width": 1088,
        "texture_height": 1088
    },

    "account": {
    },

    "geolocation": {
        "significant_dist": 5.0
    },

    "analytics": {
        "enabled": true
    },

    "//telemetry": "the engine's client for the platform's receiver (telemetry/TelemetryManager.cpp): off unless the app config's telemetry node (the shell's opt-in) or this says enabled; the rates are the client's caps, the endpoint comes from the app config",
    "telemetry": {
        "enabled": false,
        "flush_seconds": 10,
        "verbose_flush_seconds": 0.25,
        "logs_per_minute": 60,
        "verbose_logs_per_minute": 12000
    },

    "multimedia": {
    },

    "render": {
        "clear_color": "0.1 0.1 0.1 0.0",
        "enable_back_face_culling": true,
        "front_face_vertex_order": "CounterClockwise",
        "shadows_enabled": true,
        "depth": {
            "enabled": true
        },
        // The debug pass's buffers, in vertices a frame (RenderLines: lines, polygons,
        // dots). The desktop holds a map's point cloud in the editor's map view; a
        // phone the cloud of the tiles around it in the scan editor's Show map.
        "?debug": [
            { "condition": {"type": "platform", "value": "Desktop"}, "value": {"max_lines": 200000, "max_polygons": 60000, "max_dots": 500000} },
            { "condition": "", "value": {"max_lines": 20000, "max_polygons": 60000, "max_dots": 50000} }
        ]
    },

    "audio": {

    },

    "ar_core": {
    },

    "tracking": {
        "enabled": true,
        "max_targets": 5,
        "mode": "Fixed", // Manual
        "world_origin": "1 -1 1"
    },

    "input": {
        //    "key_bindings": "@key_bindings.json",
    },

    "camera_ctrl": {
        "move_speed": 10.0,
        "rotate_speed": 0.1
    },

    "camera": {
        "position": "1 1 2",
        //"position": "-1 2 0",
        "target": "0 0 0",
        "fov": 45.0,
        "minz": 0.1,
        "?maxz": [
            {
                "condition": {"type": "platform", "value": "XR"},
                "value": 50
            },
            // The desktop is where a dimension is edited: a venue's floor or a map seen
            // whole from above is hundreds of metres from the camera.
            { "condition": {"type": "platform", "value": "Desktop"}, "value": 1000 },
            { "condition": "", "value": 100 }
        ]
    },

    "physics": {
        "fixed_step": 0.016666667,
        "max_steps": 4,
        "temp_allocator_mb": 8,
        "threads": -1
    },

    "world": {
        "app_dimension": "1000000",
        "editor_dimension": "1000100",
        "public_dimension": "1000200",
        "scene": {
            "skybox": "sky",
            "lighting": {
                "type": "Directional",
                "direction": "0 -1 -0.01",

                "ambient_color": "0.4 0.4 0.4",
                "diffuse_color": "1 1 1",
                "specular_color": "0.1 0.1 0.1"
            }
        }
    },

    "imgui": {
        "fonts": {
            "default": {
                "name": "inter",
                "weight": "Normal",
                "?size": [
                    { "condition": { "type": "platform", "value": "Mobile"}, "value": 48 },
                    { "condition": "", "value": 16 }
                ]
            },
            "files" : {
                //"inter": "fonts/inter_regular.ttf"
                "inter": "fonts/inter_medium.ttf"
            },
            "load": [
                { "name": "inter", "weight": "Normal", "file": "fonts/inter_medium.ttf" },
                { "name": "inter", "weight": "Bold", "file": "fonts/inter_bold.ttf" },
                { "name": "inter", "weight": "Black", "file": "fonts/inter_black.ttf" }
            ],
            "fallback": [
            ]
        }
    },

    "materials": {
        "public_list": [
            "Standard"
        ]
    },

    "ui" : {
        "stylesheet": "@stylesheet.json"
    },
    "editor_models": "@models/editor_models.json",
    "aliases": "@aliases.json"
}
