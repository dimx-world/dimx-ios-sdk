{
    "gl_shaders": {
        "vertex": "materials/gl_shaders/standard.vs",
        "fragment": "materials/gl_shaders/standard.fs"
    },
    "parameters": {
        "baseColor": {
            "type": "Color",
            "default_value": [1, 1, 1, 1],
            "gl_uniform": "fBaseColor",
            "editable": true
        },
        "baseColorWeight": {
            "type": "Float",
            "default_value": 0,
            "gl_uniform": "fBaseColorWeight",
            "editable": true
        },
        "baseColorMap": {
            "type": "Texture",
            "default_value": "default",
            "gl_uniform": "fBaseColorMap",
            "gl_fragment_switch": "MP_fBaseColorMap",
            "editable": true
        },

        "normalMap": {
            "type": "Texture",
            "default_value": "",
            "gl_uniform": "fNormalMap",
            "gl_fragment_switch": "MP_fNormalMap",
            "editable": true
        },

        "metalness": {
            "type": "Float",
            "default_value": 0.0,
            "gl_uniform": "fMetalness",
            "editable": true
        },

        "metalnessMap": {
            "type": "Texture",
            "default_value": "",
            "gl_uniform": "fMetalnessMap",
            "gl_fragment_switch": "MP_fMetalnessMap",
            "editable": true
        },

        "roughness": {
            "type": "Float",
            "default_value": 1.0,
            "gl_uniform": "fRoughness",
            "editable": true
        },
        "roughnessMap": {
            "type": "Texture",
            "default_value": "",
            "gl_uniform": "fRoughnessMap",
            "gl_fragment_switch": "MP_fRoughnessMap",
            "editable": true
        },
        "receiveLighting": {
            "type": "Bool",
            "default_value": true,
            "gl_uniform": "fReceiveLighting",
            "editable": true
        },
        "receiveShadows": {
            "type": "Bool",
            "default_value": false,
            "gl_uniform": "fReceiveShadows"
        },
        "addColor": {
            "type": "Vec4",
            "default_value": [0, 0, 0, 0],
            "gl_uniform": "fAddColor",
            "editable": false
        },
        "multColor": {
            "type": "Vec4",
            "default_value": [1, 1, 1, 1],
            "gl_uniform": "fMultColor",
            "editable": false
        },
        "uvTransform": {
            "type": "Mat3",
            "default_value": [1, 0, 0,
                              0, 1, 0,
                              0, 0, 1],
            "gl_uniform": "vUvTransform",
            "editable": false
        }
    }
}