{
    "name": "asset-browser-screen",
    "type": "Window",
    "text": "Assets Browser",
    "closeButton": true,
    "resizable": true,
    "visible": false,
    "style": {
        "margin": "auto",
        "width": 1000,
        "height": 700,
        "flexDirection": "column",
        "opacity": 0.8,
        "padding": 0,
        "paddingRight": 0
    },
    "children": [
        {
            "name": "select-row",
            "visible": true,
            "style": {
                "flexDirection": "row",
                "width": "100%",
                "marginTop": 10,
                "padding": 10,
                "borderStyle": "solid",
                "borderWidth": 1,
                "flexShrink": 0
            },
            "children": [
                {
                    "name": "selected-asset-label",
                    "type": "Text",
                    "text": "",
                    "visible": false,
                    "style": {
                        "flexGrow": 1,
                        "verticalAlign": "center",
                        "lineClamp": 1,
                        "textOverflow": "ellipsis",
                        "color": [0.6, 0.9, 1.0, 1.0]
                    }
                },
                {
                    "name": "select-btn",
                    "type": "Button",
                    "text": "Select",
                    "visible": false,
                    "style": {
                        "marginLeft": 10,
                        "width": 90,
                        "height": 30,
                        "flexShrink": 0
                    }
                },
                {
                    "name": "cancel-btn",
                    "type": "Button",
                    "text": "Cancel",
                    "visible": false,
                    "style": {
                        "marginLeft": 6,
                        "width": 90,
                        "height": 30,
                        "flexShrink": 0
                    }
                }
            ]
        },
        {
            "name": "bottom-row",
            "type": "Splitter",
            "initialSplit": 0.3,
            "style": {
                "flexDirection": "row",
                "flexGrow": 1,
                "width": "100%",
                "marginTop": 10
            },
            "children": [
                {
                    "name": "tree-view",
                    "type": "TreeView",
                    "style": {
                        "height": "100%",
                        "flexDirection": "column"
                    },
                    "items": [
                        {
                            "id": "assets",
                            "text": "Assets",
                            "children": [
                                {
                                    "id": "models",
                                    "text": "Models",
                                    "children": [
                                        { "id": "characters", "text": "Characters" },
                                        { "id": "environment", "text": "Environment" }
                                    ]
                                },
                                {
                                    "id": "textures",
                                    "text": "Textures",
                                    "children": [
                                        { "id": "diffuse", "text": "Diffuse" },
                                        { "id": "normal", "text": "Normal" }
                                    ]
                                },
                                { "id": "audio", "text": "Audio" },
                                { "id": "scripts", "text": "Scripts" }
                            ]
                        }
                    ]
                },
                {
                    "name": "right-panel",
                    "style": {
                        "flexDirection": "column",
                        "height": "100%",
                        "paddingTop": 5,
                        "paddingRight": 10,
                        "paddingBottom": 10,
                        "paddingLeft": 10
                    },
                    "children": [
                        {
                            "name": "right-top-row",
                            "style": {
                                "width": "100%",
                                "flexDirection": "row",
                                "alignItems": "center",
                                "verticalAlign": "center"
                            },
                            "children": [
                                {
                                    "name": "up-button",
                                    "type": "Button",
                                    "classNames": ["no-frame"],
                                    "style": {
                                        "width": 30,
                                        "height": 30,
                                        "margin": 0,
                                        "flexShrink": 0,
                                        "backgroundImage": "editor-assets-ui.png",
                                        "backgroundImageRect": [0, 300, 30, 30]
                                    }
                                },
                                {
                                    "name": "breadcrumb",
                                    "type": "Text",
                                    "text": "Assets",
                                    "style": {
                                        "width": "100%",
                                        "height": 30,
                                        "marginLeft": 5,
                                        "marginRight": 20,
                                        "verticalAlign": "center",
                                        "lineClamp": 1,
                                        "textOverflow": "ellipsis-start"
                                    }
                                },
                                {
                                    "name": "add-btn",
                                    "type": "Button",
                                    "text": "Add..",
                                    "style": {
                                        "marginLeft": "auto",
                                        "width": 100,
                                        "height": 30,
                                        "borderRadius": 3,
                                        "borderStyle": "none",
                                        "flexShrink": 0,
                                        "paddingLeft": 5,
                                        "backgroundColor": [0, 0, 0, 0],
                                        "backgroundImage": "editor-assets-ui.png",
                                        "backgroundImageRect": [30, 300, 30, 30],
                                        "backgroundPosition": "left",
                                        "textAlign": "left"
                                    }
                                }
                            ]
                        },
                        {
                            "name": "pending-imports",
                            "visible": false,
                            "style": {
                                "width": "100%",
                                "flexDirection": "column",
                                "marginLeft": 10,
                                "marginTop": 5,
                                "padding": 5,
                                "gap": 3,
                                "flexShrink": 0,
                                "backgroundColor": [0.15, 0.15, 0.15, 0.8],
                                "borderRadius": 3
                            },
                            "custom": {
                                "itemTemplate": {
                                    "name": "pending-item",
                                    "style": {
                                        "flexDirection": "row",
                                        "alignItems": "center",
                                        "width": "100%",
                                        "height": 22,
                                        "gap": 8
                                    },
                                    "children": [
                                        {
                                            "name": "pending-item-spinner",
                                            "type": "Text",
                                            "text": "...",
                                            "style": {
                                                "width": 20,
                                                "textAlign": "center",
                                                "color": [0.5, 0.8, 1.0, 1.0]
                                            }
                                        },
                                        {
                                            "name": "pending-item-text",
                                            "type": "Text",
                                            "text": "",
                                            "style": {
                                                "width": "100%",
                                                "lineClamp": 1,
                                                "textOverflow": "ellipsis",
                                                "color": [0.7, 0.7, 0.7, 1.0]
                                            }
                                        }
                                    ]
                                }
                            }
                        },
                        {
                            "name": "folder-cont",
                            "draggableChildren": true,
                            "style": {
                                "flexGrow": 1,
                                "marginLeft": 10,
                                "padding": 0,
                                "gap": 20,
                                "alignItems": "flexStart",
                                "alignContent": "flexStart",
                                "flexWrap": "wrap",
                                "overflow": "scroll",

                                "borderStyle": "none"
                            },
                            "custom": {
                                "itemTemplate": {
                                    "name": "folder-item",
                                    "type": "Button",
                                    "style": {
                                        "flexDirection": "column",
                                        "borderStyle": "none",
                                        "backgroundColor": [0, 0, 0, 0]

                                    },
                                    "children": [
                                        {
                                            "name": "folder-item-icon",
                                            "type": "Image",
                                            "dropTarget": true,
                                            "style": {
                                                "padding": 10,
                                                "width": 100,
                                                "height": 100,
                                                "flexShrink": 0,
                                                "backgroundImage": "editor-assets-ui.png",
                                                "backgroundImageRect": [0, 150, 150, 150]

                                            }
                                        },
                                        {
                                            "name": "folder-item-text",
                                            "type": "Text",
                                            "text": "asset.png",
                                            "style": {
                                                "padding": 10,
                                                "width": 100,
                                                "maxHeight": 120,
                                                "flexShrink": 0,
                                                "textAlign": "center",
                                                "verticalAlign": "center",
                                                "lineClamp": 3,
                                                "textOverflow": "ellipsis"
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    ]
                }
            ]
        }
       
    ]
}
