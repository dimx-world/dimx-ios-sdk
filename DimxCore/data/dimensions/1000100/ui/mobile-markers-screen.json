{
    "?_ignore_": [
        { "condition": {"type": "platform", "value": "Mobile"}, "value": false },
        { "condition": "", "value": true }
    ],

    "_comment": "Not modal: New location here asks a name through the app's prompt, a modal, and two modals in the one on-screen ImGui context close each other every frame.",
    "name": "mobile-markers-screen",
    "type": "Window",
    "text": "Markers",
    "visible": false,
    "modal": false,
    "closeButton": true,
    "scrollable": true,
    "style": {
        "marginLeft": "auto",
        "marginRight": "auto",
        "marginTop": 400,
        "width": 800,
        "height": 1200,
        "flexDirection": "column",
        "gap": 20,
        "padding": 20
    },
    "children": [
        {
            "name": "new-location-btn",
            "type": "Button",
            "text": "New location here",
            "style": {
                "height": 120,
                "width": "100%"
            }
        },
        {
            "name": "markers-cont",
            "style": {
                "width": "100%",
                "flexDirection": "column",
                "gap": 10,
                "flexGrow": 1
            },
            "custom": {
                "itemTemplate": {
                    "style": {
                        "width": "100%",
                        "minHeight": 160
                    },
                    "children": [
                        {
                            "name": "item-btn",
                            "type": "Button",
                            "toggle": true,
                            "classNames": [ "no-frame" ],
                            "style": {
                                "width": "100%",
                                "height": 150,
                                "backgroundImage": "marker-thumbnail",
                                "backgroundPosition": "left",
                                "textAlign": "left"
                            }
                        },
                        {
                            "name": "title-txt",
                            "type": "Text",
                            "text": "Marker-1234",
                            "style": {
                                "left": 160,
                                "top": 0,
                                "right": 10,
                                "height": 50
                            }
                        },
                        {
                            "name": "status-txt",
                            "type": "Text",
                            "text": "Located",
                            "style": {
                                "left": 160,
                                "top": 55,
                                "right": 10,
                                "height": 50
                            }
                        },
                        {
                            "_ignore_": true,
                            "name": "rename-btn",
                            "type": "Button",
                            "text": "Rename",
                            "visible": false,
                            "style": {
                                "left": 10,
                                "top": 160,
                                "width": 300,
                                "height": 80
                            }
                        },
                        {
                            "_ignore_": true,
                            "name": "delete-btn",
                            "type": "Button",
                            "text": "Delete",
                            "visible": false,
                            "style": {
                                "left": 320,
                                "top": 160,
                                "width": 300,
                                "height": 80
                            }
                        }
                    ]
                }
            }
        }
    ]
}