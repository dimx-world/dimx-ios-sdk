{
    "?_ignore_": [
        { "condition": {"type": "platform", "value": "Mobile"}, "value": false },
        { "condition": "", "value": true }
    ],

    "name": "mobile-properties-screen",
    "type": "Window",
    "text": "Properties",
    "visible": false,
    "modal": true,
    "closeButton": true,
    "scrollable": true,
    "style": {
        "marginLeft": 0,
        "marginRight": 0,
        "width": "100%",
        "height": "100%",
        "flexDirection": "column",
        "padding": 20,
        "gap": 20
    },
    "children": [
        {
            "name": "delete-btn",
            "type": "Button",
            "text": "Delete",
            "style": {
                "marginTop": 20,
                "marginLeft": "auto",
                "width": 350,
                "height": 100
            }
        },
        {
            "name": "props-view",
            "type": "PropertyView",
            "keepFirstItemOpen": true,
            "sameLineLabel": false,
            "style": {
                "width": "100%",
                "flexGrow": 1
            }
        }
    ]
}
