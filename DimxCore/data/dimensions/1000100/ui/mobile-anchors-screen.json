{
    "?_ignore_": [
        { "condition": {"type": "platform", "value": "Mobile"}, "value": false },
        { "condition": "", "value": true }
    ],

    "name": "mobile-anchors-screen",
    "type": "Window",
    "text": "Cloud Anchors",
    "visible": false,
    "modal": true,
    "closeButton": true,
    "scrollable": true,
    "style": {
        "marginLeft": "auto",
        "marginRight": "auto",
        "marginTop": 400,
        "width": 800,
        "height": 1200,
        "flexDirection": "column",
        "gap": 20,
        "padding": 20
    },
    "children": [
        {
            "name": "create-btn",
            "type": "Button",
            "text": "New Anchor",
            "classNames": [ "no-frame" ],
            "style": {
                "marginTop": 20,
                "height": 140,
                "width": "100%",
                "backgroundImage": "editor-mobile-ui",
                "backgroundImageRect": [400, 300, 100, 100],
                "backgroundPosition": "left",
                "textAlign": "left"
            }
        },
        {
            "name": "anchors-cont",
            "style": {
                "width": "100%",
                "flexDirection": "column",
                "gap": 10,
                "flexGrow": 1
            },
            "custom": {
                "itemTemplate": {
                    "style": {
                        "width": "100%",
                        "minHeight": 160
                    },
                    "children": [
                        {
                            "name": "item-btn",
                            "type": "Button",
                            "toggle": true,
                            "classNames": [ "no-frame" ],
                            "style": {
                                "width": "100%",
                                "height": 150,
                                "backgroundImage": "cloud-anchor-thumbnail",
                                "backgroundPosition": "left",
                                "textAlign": "left"
                            }
                        },
                        {
                            "name": "title-txt",
                            "type": "Text",
                            "text": "Anchor-1234",
                            "style": {
                                "left": 160,
                                "top": 0,
                                "right": 10,
                                "height": 50
                            }
                        },
                        {
                            "name": "status-txt",
                            "type": "Text",
                            "text": "Located",
                            "style": {
                                "left": 160,
                                "top": 55,
                                "right": 10,
                                "height": 50
                            }
                        },
                        {
                            "_ignore_": true,
                            "name": "rename-btn",
                            "type": "Button",
                            "text": "Rename",
                            "visible": false,
                            "style": {
                                "left": 10,
                                "top": 160,
                                "width": 300,
                                "height": 80
                            }
                        },
                        {
                            "_ignore_": true,
                            "name": "delete-btn",
                            "type": "Button",
                            "text": "Delete",
                            "visible": false,
                            "style": {
                                "left": 320,
                                "top": 160,
                                "width": 300,
                                "height": 80
                            }
                        }
                    ]
                }
            }
        }
    ]
}