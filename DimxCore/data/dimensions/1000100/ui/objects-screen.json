{
    "name": "objects-screen",
    "type": "Window",
    "text": "Select Object",
    "visible": false,
    "modal": true,
    "closeButton": true,
    "scrollable": true,
    "?style": [
        {
            "condition": {"type": "platform", "value": "Mobile"},
            "value": {
                "width": "100%",
                "marginTop": 200,
                "flexDirection": "column"
            }
        },
        {
            "condition": "",
            "value": {
                "marginLeft": "auto",
                "marginRight": "auto",
                "marginTop": 55,
                "width": 460,
                "flexDirection": "column"
            }
        }
    ],
    "children": [
        {
            "name": "filter-bar",
            "type": "Element",
            "style": {
                "marginTop": 35,
                "marginLeft": 20,
                "marginRight": 20,
                "width": "100%",
                "flexDirection": "row"
            },
            "children": [
                {
                    "name": "all-filter-btn",
                    "type": "Button",
                    "text": "All",
                    "toggle": true,
                    "pushed": true,
                    "?visible": [
                        { "condition": {"type": "platform", "value": "Mobile"}, "value": false },
                        { "condition": "", "value": true }
                    ],
                    "style": {
                        "width": 50,
                        "height": 50,
                        "borderRadius": 0
                    }
                },
                {
                    "name": "objects-filter-btn",
                    "type": "Button",
                    "text": "Objects",
                    "toggle": true,
                    "?visible": [
                        { "condition": {"type": "platform", "value": "Mobile"}, "value": false },
                        { "condition": "", "value": true }
                    ],
                    "style": {
                        "width": 120,
                        "height": 50,
                        "borderRadius": 0
                    }
                },
                {
                    "name": "markers-filter-btn",
                    "type": "Button",
                    "text": "Markers",
                    "toggle": true,
                    "?visible": [
                        { "condition": {"type": "platform", "value": "Mobile"}, "value": false },
                        { "condition": "", "value": true }
                    ],
                    "style": {
                        "width": 120,
                        "height": 50,
                        "borderRadius": 0
                    }
                },
                {
                    "name": "anchors-filter-btn",
                    "type": "Button",
                    "text": "CloudAnchors",
                    "toggle": true,
                    "?visible": [
                        { "condition": {"type": "platform", "value": "Mobile"}, "value": false },
                        { "condition": "", "value": true }
                    ],
                    "style": {
                        "width": 120,
                        "height": 50,
                        "borderRadius": 0
                    }
                }
            ]
        },
        {
            "name": "objects-cont",
            "style": {
                "width": "100%",
                "flexDirection": "column",
                "flexGrow": 1
            },
            "custom": {
                "itemTemplate": {
                    "type": "Button",
                    "name": "row-btn",
                    "text": "object",
                    "classNames": [ "no-frame" ],
                    "style": {
                        "width": "100%",
                        "?height": [
                            { "condition": {"type": "platform", "value": "Mobile"}, "value": 150 },
                            { "condition": "", "value": 50 }
                        ],
                        "backgroundImage": "model-thumbnail",
                        "backgroundPosition": "left",
                        "textAlign": "left"
                    }
                }
            }
        }
    ]
}