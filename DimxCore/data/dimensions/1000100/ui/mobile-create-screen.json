{
    "?_ignore_": [
        { "condition": {"type": "platform", "value": "Mobile"}, "value": false },
        { "condition": "", "value": true }
    ],

    "name": "mobile-create-screen",
    "type": "Window",
    "text": "Create New Object",
    "visible": false,
    "modal": true,
    "closeButton": true,
    "scrollable": true,
    "style": {
        "marginLeft": 0,
        "marginRight": 0,
        "marginTop": 200,
        "width": "100%",
        "flexDirection": "column",
        "gap": 10,
        "padding": 10
    },
    "children": [
        {
            "name": "standard-frame",
            "type": "CollapseFrame",
            "text": "Standard Models",
            "style": {
                "marginTop": 10,
                "flexShrink": 0,
                "minHeight": 30,
                "width": "100%"
            },
            "children": [
                {
                    "name": "standard-cont",
                    "style": {
                        "width": "100%",
                        "flexDirection": "column",
                        "gap": 5,
                        "flexGrow": 1
                    },
                    "custom": {
                        "itemTemplate": {
                            "type": "Button",
                            "name": "row-btn",
                            "text": "box",
                            "classNames": ["no-frame"],
                            "style": {
                                "width": "100%",
                                "height": 150,
                                "backgroundPosition": "left",
                                "textAlign": "left"
                            }
                        }
                    }
                }
            ]
        },
        {
            "name": "dimension-models-frame",
            "type": "CollapseFrame",
            "text": "Dimension Models",
            "style": {
                "flexShrink": 0,
                "minHeight": 30,
                "width": "100%"
            },
            "children": [
                {
                    "name": "dimension-models-cont",
                    "style": {
                        "width": "100%",
                        "flexDirection": "column",
                        "gap": 5,
                        "flexGrow": 1
                    },
                    "custom": {
                        "itemTemplate": {
                            "type": "Button",
                            "name": "row-btn",
                            "text": "model",
                            "classNames": ["no-frame"],
                            "style": {
                                "width": "100%",
                                "height": 150,
                                "backgroundPosition": "left",
                                "textAlign": "left"
                            }
                        }
                    }
                }
            ]
        },
        {
            "name": "helpers-frame",
            "type": "CollapseFrame",
            "text": "Helpers",
            "style": {
                "flexShrink": 0,
                "minHeight": 30,
                "width": "100%"
            },
            "children": [
                {
                    "name": "helpers-cont",
                    "style": {
                        "width": "100%",
                        "flexDirection": "column",
                        "gap": 5
                    },
                    "children" : [
                        {
                            "name": "dummy-btn",
                            "type": "Button",
                            "text": "Dummy",
                            "classNames": ["no-frame"],
                            "style": {
                                "height": 150,
                                "width": "100%",
                                "backgroundImage": "dummy-thumbnail",
                                "backgroundPosition": "left",
                                "textAlign": "left"
                            }
                        },
                        {
                            "name": "sticky-dummy-floor-btn",
                            "type": "Button",
                            "text": "Floor Sticky Dummy",
                            "classNames": ["no-frame"],
                            "style": {
                                "height": 150,
                                "width": "100%",
                                "backgroundImage": "sticky-dummy-floor-thumbnail",
                                "backgroundPosition": "left",
                                "textAlign": "left"
                            }
                        },
                        {
                            "name": "sticky-dummy-wall-btn",
                            "type": "Button",
                            "text": "Wall Sticky Dummy",
                            "classNames": ["no-frame"],
                            "style": {
                                "height": 150,
                                "width": "100%",
                                "backgroundImage": "sticky-dummy-wall-thumbnail",
                                "backgroundPosition": "left",
                                "textAlign": "left"
                            }
                        }
                    ]
                }
            ]
        }
    ]
}
