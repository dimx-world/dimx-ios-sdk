 {
    "name": "object-placement-screen",
    "type": "Window",
    "visible": false,
    "style": {
        "marginLeft": 0,
        "marginTop": 0,
        "width": "100%",
        "height": "100%",
        "flexDirection": "column",
        "backgroundColor": [0, 0, 0, 0]
    },
    "children": [
        {
            "name": "message-text",
            "type": "Text",
            "text": "Finding surface..",
            "style": {
                "marginLeft": 10,
                "marginRight": 10,
                "marginTop": 50,
                "width": "100%",
                "height": 100
            }
        },
        {
            "name": "translate-scale-row",
            "style": {
                "width": "100%",
                "flexDirection": "row",
                "flexGrow": 1,
                "alignItems": "stretch",
                "gap": 10
            },
            "children": [
                {
                    "name": "translate-touch",
                    "type": "TouchPad",
                    "classNames": [ "no-frame" ],
                    "style": {
                        "marginLeft": 0,
                        "marginTop": 0,
                        "flexGrow": 1,
                        "minWidth": 0
                    }
                },
                {
                    "name": "scale-pinch-container",
                    "style": {
                        "marginLeft": "auto",
                        "marginRight": 0,
                        "marginTop": 0,
                        "flexDirection": "column",
                        "alignItems": "flex-end",
                        "gap": 20
                    },
                    "children": [
                        {
                            "name": "scale-touch",
                            "type": "TouchPad",
                            "classNames": [ "no-frame" ],
                            "style": {
                                "marginLeft": "auto",
                                "marginRight": 60,
                                "marginTop": "auto",
                                "width": 100,
                                "height": 800,
                                "backgroundImage": "editor-mobile-ui",
                                "backgroundImageRect": [0, 280, 40, 180]
                            }
                        },
                        {
                            "name": "pinch-btn",
                            "type": "Button",
                            "toggle": true,
                            "classNames": [ "no-frame" ],
                            "style": {
                                "marginLeft": "auto",
                                "marginRight": 10,
                                "marginTop": "auto",
                                "width": 200,
                                "height": 200,
                                "backgroundImage": "editor-mobile-ui",
                                "backgroundImageRect": [200, 200, 100, 100]
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "rotate-touch",
            "type": "TouchPad",
            "style": {
                "width": "100%",
                "marginLeft": 0,
                "marginTop": "auto",
                "height": 200,
                "backgroundImage": "editor-mobile-ui",
                "backgroundImageRect": [0, 200, 200, 80],
                "backgroundColor": [0, 0, 0, 0]
            }
        },
        
        {
            "name": "action-row",
            "style": {
                "width": "100%",
                "flexDirection": "row",
                "justifyContent": "space-between",
                "alignItems": "center",
                "gap": 20,
                "marginTop": 20,
                "marginBottom": 50,
                "paddingLeft": 50,
                "paddingRight": 50
            },
            "children": [
                {
                    "name": "place-btn",
                    "type": "Button",
                    "text": "Ok",
                    "style": {
                        "width": 360,
                        "height": 120
                    }
                },
                {
                    "name": "cancel-btn",
                    "type": "Button",
                    "text": "Cancel",
                    "style": {
                        "width": 360,
                        "height": 120
                    }
                }
            ]
        }
    ]
}
