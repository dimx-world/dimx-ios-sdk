{
    "?_ignore_": [
        { "condition": {"type": "platform", "value": "Desktop"}, "value": false },
        { "condition": "", "value": true }
    ],

    "name": "create-panel",
    "visible": false,
    "type": "Window",
    "panel": true,
    "style": {
        "marginLeft": 5,
        "marginTop": 55,
        "width": 250,
        "flexDirection": "column",
        "padding": 10,
        "gap": 5,
        "borderStyle": "none",
        "borderRadius": 0
    },
    "styleSheet": {
        "Button": {
            "width": "100%",
            "minHeight": 50,
            "backgroundColor": [0, 0, 0, 0],
            "borderStyle": "none",
            "borderRadius": 0,
            "paddingLeft": 10,
            "paddingRight": 10,
            "backgroundPosition": "left",
            "textAlign": "left"
        }
    },
    "children": [
        {
            "name": "standard-frame",
            "type": "CollapseFrame",
            "text": "Standard Models",
            "style": {
                "flexShrink": 0,
                "minHeight": 30,
                "width": "100%",
                "paddingTop": 30
            },
            "children": [
                {
                    "name": "standard-models-container",
                    "style": {
                        "width": "100%",
                        "flexDirection": "column"
                    },
                    "custom": {
                        "itemTemplate": {
                            "type": "Button",
                            "name": "row-btn",
                            "text": "box"
                        }
                    }
                }
            ]
        },
        {
            "name": "dimension-models-frame",
            "type": "CollapseFrame",
            "text": "Dimension Models",
            "style": {
                "flexShrink": 0,
                "minHeight": 30,
                "width": "100%",
                "paddingTop": 30
            },
            "children": [
                {
                    "name": "dimension-models-container",
                    "style": {
                        "width": "100%",
                        "flexDirection": "column",
                        "flexGrow": 1
                    },
                    "custom": {
                        "itemTemplate": {
                            "type": "Button",
                            "name": "row-btn",
                            "text": "box"
                        }
                    }
                }
            ]
        },
        {
            "name": "multimedia-frame",
            "type": "CollapseFrame",
            "text": "Multimedia",
            "style": {
                "flexShrink": 0,
                "minHeight": 30,
                "width": "100%",
                "paddingTop": 30,
                "flexDirection": "column"
            },
            "children": [
                {
                    "name": "video-btn",
                    "type": "Button",
                    "text": "Video",
                    "style": {
                        "backgroundImage": "video-thumbnail"
                    }
                },
                {
                    "name": "audio-btn",
                    "type": "Button",
                    "text": "Audio",
                    "style": {
                        "backgroundImage": "audio-thumbnail"
                    }
                }
            ]
        },
        {
            "name": "markers-frame",
            "type": "CollapseFrame",
            "text": "Markers",
            "style": {
                "flexShrink": 0,
                "minHeight": 30,
                "width": "100%",
                "paddingTop": 30,
                "flexDirection": "column"
            },
            "children": [
                {
                    "name": "vertical-marker-btn",
                    "type": "Button",
                    "text": "Vertical",
                    "style": {
                        "backgroundImage": "vertical-marker-thumb"
                    }
                },
                {
                    "name": "horizontal-marker-btn",
                    "type": "Button",
                    "text": "Horizontal",
                    "style": {
                        "backgroundImage": "horizontal-marker-thumb"
                    }
                }
            ]
        },
        {
            "name": "helpers-frame",
            "type": "CollapseFrame",
            "text": "Helpers",
            "style": {
                "flexShrink": 0,
                "minHeight": 30,
                "width": "100%",
                "paddingTop": 30,
                "flexDirection": "column"
            },
            "children": [
                {
                    "name": "dummy-btn",
                    "type": "Button",
                    "text": "Dummy",
                    "style": {
                        "backgroundImage": "dummy-thumbnail"
                    }
                },
                {
                    "name": "sticky-dummy-floor-btn",
                    "type": "Button",
                    "text": "Floor Sticky Dummy",
                    "style": {
                        "backgroundImage": "sticky-dummy-floor-thumbnail"
                    }
                },
                {
                    "name": "sticky-dummy-wall-btn",
                    "type": "Button",
                    "text": "Wall Sticky Dummy",
                    "style": {
                        "backgroundImage": "sticky-dummy-wall-thumbnail"
                    }
                }
            ]
        }
    ]
}
