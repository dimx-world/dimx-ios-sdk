{
    "?_ignore_": [
        { "condition": {"type": "platform", "value": "Desktop"}, "value": false },
        { "condition": "", "value": true }
    ],

    "name": "top-panel",
    "type": "Window",
    "panel": true,
    "style": {
        "marginTop": 5,
        "padding": 5,
        "width": "100%",
        "height": 50,
        "flexDirection": "row",
        "alignItems": "center",
        "borderStyle": "none",
        "borderRadius": 0
    },
    "styleSheet": {
        "Button": {
            "height": 30,
            "paddingLeft": 10,
            "paddingRight": 10,
            "textAlign": "left"
        }
    },
    "children": [
        {
            "name": "logo-icon",
            "type": "Image",
            "visible": true,
            "style": {
                "width": 40,
                "height": 40,
                "backgroundImage": "editor-desktop-ui",
                "backgroundImageRect": [0, 100, 100, 100]
            }
        },
        {
            "name": "selected-dim-text",
            "type": "Button",
            "text": "Select dimension..",
            "?enabled": [
                { "condition": {"type": "platform", "value": "Web"}, "value": false },
                { "condition": "", "value": true }
            ],
            "classNames": [ "no-frame" ],
            "style": {
                "marginLeft": 40,
                "width": 250,
                "backgroundImage": "editor-desktop-ui",
                "backgroundImageRect": [250, 0, 50, 50],
                "backgroundPosition": "left"
            }
        },
        {
            "name": "selected-loc-text",
            "type": "Button",
            "text": "Select location..",
            "classNames": [ "no-frame" ],
            "style": {
                "marginLeft": 10,
                "width": 250,
                "backgroundImage": "editor-desktop-ui",
                "backgroundImageRect": [250, 50, 50, 50],
                "backgroundPosition": "left"
            }
        },
        {
            "name": "assets-btn",
            "type": "Button",
            "text": "Assets",
            "classNames": [ "no-frame" ],
            "style": {
                "marginLeft": 10,
                "width": 120,
                "backgroundImage": "editor-desktop-ui",
                "backgroundImageRect": [0, 50, 50, 50],
                "backgroundPosition": "left"
            }
        },

        {
            "name": "viewer-btn",
            "type": "Button",
            "classNames": [ "no-frame" ],
            "style": {
                "marginLeft": "auto",
                "width": 50,
                "backgroundImage": "editor-desktop-ui",
                "backgroundImageRect": [300, 50, 50, 50]
            }
        },

        {
            "name": "reload-btn",
            "type": "Button",
            "text": "Reload",
            "classNames": [ "no-frame" ],
            "style": {
                "marginLeft": 10,
                "width": 120,
                "backgroundImage": "editor-desktop-ui",
                "backgroundImageRect": [300, 0, 50, 50],
                "backgroundPosition": "left"
            }
        },

        {
            "name": "save-btn",
            "type": "Button",
            "text": "Saving...",
            "classNames": [ "no-frame" ],
            "style": {
                "marginLeft": 10,
                "width": 120,
                "backgroundImage": "editor-desktop-ui",
                "backgroundImageRect": [400, 50, 50, 50],
                "backgroundPosition": "left"
            }
        },

        {
            "name": "publish-btn",
            "type": "Button",
            "text": "Publish",
            "classNames": [ "no-frame" ],
            "style": {
                "marginLeft": 10,
                "width": 120,
                "backgroundImage": "editor-desktop-ui",
                "backgroundImageRect": [350, 0, 50, 50],
                "backgroundPosition": "left"
            }
        },

        {
            "name": "settings-btn",
            "type": "Button",
            "classNames": [ "no-frame" ],
            "style": {
                "marginLeft": 10,
                "width": 30,
                "backgroundImage": "editor-desktop-ui",
                "backgroundImageRect": [400, 0, 50, 50]
            }
        },


        {
            "name": "menu-btn",
            "type": "Button",
            "classNames": [ "no-frame" ],
            "style": {
                "marginLeft": 10,
                "marginRight": 10,
                "width": 30,
                "backgroundImage": "editor-desktop-ui",
                "backgroundImageRect": [450, 0, 50, 50]
            }
        }
    ]
}