{
    "?_ignore_": [
        { "condition": {"type": "platform", "value": "Desktop"}, "value": false },
        { "condition": "", "value": true }
    ],

    "name": "properties-screen",
    "type": "Window",
    "scrollable": false,
    "panel": true,
    "resizeEdge": "Left",
    "style": {
        "marginLeft": "auto",
        "marginRight": 0,
        "marginTop": 55,
        "marginBottom": 5,
        "padding": 10,
        "maxWidth": 400,
        "flexDirection": "column",
        "flexGrow": 1,
        "borderStyle": "none",
        "borderRadius": 0
    },
    "children": [
        {
            "name": "tab-bar",
            "type": "TabBar",
            "style": {
                "marginTop": 3
            },
            "children": [
                {
                    "name": "tab-bar-selection",
                    "type": "TabBarItem",
                    "text": "Selection",
                    "style": {
                        "paddingTop": 35,
                        "flexDirection": "column",
                        "flexGrow": 1
                    },
                    "children": [
                        {
                            "name": "delete-btn",
                            "type": "Button",
                            "style": {
                                "marginLeft": "auto",
                                "width": 100,
                                "height": 30
                            },
                            "text": "Delete"
                        },
                        {
                            "name": "selected-props-view",
                            "type": "PropertyView",
                            "keepFirstItemOpen": true,
                            "style": {
                                "marginTop": 5,
                                "width": "100%",
                                "flexGrow": 1
                            }
                        }
                    ]
                },
                {
                    "name": "tab-bar-dimension",
                    "type": "TabBarItem",
                    "text": "Dimension",
                    "style": {
                        "paddingTop": 30
                    },
                    "children": [
                        {
                            "name": "dimension-props-view",
                            "type": "PropertyView",
                            "keepFirstItemOpen": true,
                            "style": {
                                "width": "100%",
                                "flexGrow": 1
                            }
                        }
                    ]
                },
                {
                    "name": "tab-bar-location",
                    "type": "TabBarItem",
                    "text": "Location",
                    "style": {
                        "paddingTop": 30
                    },
                    "children": [
                        {
                            "name": "location-props-view",
                            "type": "PropertyView",
                            "keepFirstItemOpen": true,
                            "style": {
                                "width": "100%",
                                "flexGrow": 1
                            }
                        }
                    ]
                }
            ]
        }
    ]
}