{
    "_comment": "The scan editor's Session (EditorScanSessionScreen): Record session records what the map tracker sees here for the desk (SessionRecorder), and for the newest session kept on the device Send session and Discard (SessionStore) - a recording leaves the device by that button and by the app's question alone. Sizes in UI points: 1000 across the screen.",
    "?_ignore_": [
        { "condition": {"type": "platform", "value": "Mobile"}, "value": false },
        { "condition": "", "value": true }
    ],

    "name": "scan-editor-session",
    "type": "Window",
    "text": "Localization session",
    "visible": false,
    "modal": true,
    "closeButton": true,
    "style": {
        "marginLeft": "auto",
        "marginRight": "auto",
        "marginTop": "auto",
        "marginBottom": "auto",
        "width": 900,
        "flexDirection": "column",
        "gap": 20,
        "padding": 24
    },
    "children": [
        {
            "name": "about-txt",
            "type": "Text",
            "text": "A session records what the camera and the map tracker do here, so the desk can replay a place that will not localize.",
            "style": {
                "width": "100%",
                "fontSize": 29,
                "color": [0.78, 0.84, 0.9, 1]
            }
        },
        {
            "name": "record-btn",
            "type": "Button",
            "text": "Record session",
            "style": {
                "width": "100%",
                "height": 120,
                "fontSize": 36
            }
        },
        {
            "name": "status-txt",
            "type": "Text",
            "text": "",
            "style": {
                "width": "100%",
                "fontSize": 30
            }
        },
        {
            "name": "session-txt",
            "type": "Text",
            "text": "No session kept on this device",
            "style": {
                "width": "100%",
                "fontSize": 30
            }
        },
        {
            "name": "session-buttons",
            "style": {
                "width": "100%",
                "flexDirection": "row",
                "gap": 20
            },
            "children": [
                {
                    "name": "send-btn",
                    "type": "Button",
                    "text": "Send session",
                    "style": {
                        "height": 120,
                        "flexGrow": 1,
                        "flexBasis": 0,
                        "fontSize": 34
                    }
                },
                {
                    "name": "discard-btn",
                    "type": "Button",
                    "text": "Discard",
                    "style": {
                        "height": 120,
                        "flexGrow": 1,
                        "flexBasis": 0,
                        "fontSize": 34
                    }
                }
            ]
        }
    ]
}
