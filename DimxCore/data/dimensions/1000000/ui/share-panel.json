{
    "_comment": "The captures of the AR screen (AppMobileSharePanel, whose shutter is in the bottom bar, mobile-main-screen.json): a column at the right edge of the screen (marginRight 20, where the right panel's buttons stand too, higher up), standing on the bar's top (marginBottom 222 = the bar's 40 + 162 + 20), one thumbnail per photo or video made from the item template - a 158 pt frame around a 150 pt image, the 4 pt of room keeping the image's border, drawn centred on its edge, out of the frame's clip - newest at the bottom, each fading out after ten seconds; a tap on one opens the share sheet with it. The window stays shown and empty between captures. Sizes in UI points: 1000 across the screen.",
    "?_ignore_": [
        { "condition": {"type": "platform", "value": "Mobile"}, "value": false },
        { "condition": "", "value": true }
    ],

    "name": "share-panel",
    "type": "Window",
    "panel": true,
    "visible": false,
    "classNames": [ "no-frame" ],
    "style": {
        "marginLeft": "auto",
        "marginRight": 20,
        "marginTop": "auto",
        "marginBottom": 222,
        "opacity": 1,
        "padding": 0,
        "flexDirection": "column",
        "alignItems": "flex-end"
    },
    "children": [
        {
            "name": "captures",
            "type": "Element",
            "style": {
                "flexDirection": "column",
                "alignItems": "flex-end",
                "gap": 14
            },
            "custom": {
                "itemTemplate": {
                    "name": "",
                    "type": "Element",
                    "style": {
                        "width": 158,
                        "height": 158,
                        "flexShrink": 0
                    },
                    "children": [
                        {
                            "name": "thumb",
                            "type": "Image",
                            "style": {
                                "positionType": "absolute",
                                "left": 4,
                                "top": 4,
                                "width": 150,
                                "height": 150,
                                "objectFit": "cover",
                                "borderRadius": 22,
                                "borderStyle": "solid",
                                "borderWidth": 4,
                                "borderColor": [1, 1, 1, 1],
                                "backgroundColor": [0, 0, 0, 0.4]
                            }
                        },
                        {
                            "name": "thumb-badge",
                            "type": "Text",
                            "text": "VIDEO",
                            "visible": false,
                            "style": {
                                "positionType": "absolute",
                                "left": 14,
                                "bottom": 14,
                                "paddingLeft": 10,
                                "paddingRight": 10,
                                "paddingTop": 3,
                                "paddingBottom": 3,
                                "borderRadius": 10,
                                "color": [1, 1, 1, 1],
                                "fontSize": 18,
                                "backgroundColor": [0, 0, 0, 0.6]
                            }
                        }
                    ]
                }
            }
        }
    ]
}
