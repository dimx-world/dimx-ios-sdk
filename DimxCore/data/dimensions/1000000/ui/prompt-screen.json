 {
    "_comment": "The engine's text prompt (AppPromptScreen). On a phone it is 900 points of the screen's 1000 wide, its text, input and buttons at sizes a finger can use; the desktop keeps the small dialog.",
    "name": "prompt-screen",
    "type": "Window",
    "visible": false,
    "closeButton": false,
    "?style": [
        {
            "condition": {"type": "platform", "value": "Mobile"},
            "value": {
                "margin": "auto",
                "width": 900,
                "flexDirection": "column",
                "gap": 24,
                "padding": 30,
                "fontSize": 40
            }
        },
        {
            "condition": "",
            "value": {
                "margin": "auto",
                "width": 500,
                "flexDirection": "column",
                "padding": 20
            }
        }
    ],
    "modal": true,
    "text": "Dialog",
    "children": [
        {
            "name": "details",
            "type": "Text",
            "text": "Please enter the required information below:",
            "?style": [
                {
                    "condition": {"type": "platform", "value": "Mobile"},
                    "value": {
                        "width": "100%",
                        "fontSize": 34
                    }
                },
                {
                    "condition": "",
                    "value": {
                        "width": "100%",
                        "margin": 20
                    }
                }
            ]
        },
        {
            "name": "input-txt",
            "type": "InputText",
            "?style": [
                {
                    "condition": {"type": "platform", "value": "Mobile"},
                    "value": {
                        "width": "100%",
                        "height": 100,
                        "fontSize": 40
                    }
                },
                {
                    "condition": "",
                    "value": {
                        "width": "100%",
                        "marginBottom": 20
                    }
                }
            ]
        },
        {
            "name": "button-container",
            "type": "Element",
            "?style": [
                {
                    "condition": {"type": "platform", "value": "Mobile"},
                    "value": {
                        "width": "100%",
                        "flexDirection": "row",
                        "gap": 30,
                        "marginTop": 10
                    }
                },
                {
                    "condition": "",
                    "value": {
                        "width": "100%",
                        "flexDirection": "row",
                        "justifyContent": "center",
                        "gap": 50
                    }
                }
            ],
            "children": [
                {
                    "name": "ok-btn",
                    "type": "Button",
                    "text": "OK",
                    "?style": [
                        {
                            "condition": {"type": "platform", "value": "Mobile"},
                            "value": {
                                "height": 120,
                                "flexGrow": 1,
                                "flexBasis": 0,
                                "borderRadius": 24,
                                "fontSize": 40
                            }
                        },
                        {
                            "condition": "",
                            "value": {
                                "padding": 10
                            }
                        }
                    ]
                },
                {
                    "name": "cancel-btn",
                    "type": "Button",
                    "text": "Cancel",
                    "?style": [
                        {
                            "condition": {"type": "platform", "value": "Mobile"},
                            "value": {
                                "height": 120,
                                "flexGrow": 1,
                                "flexBasis": 0,
                                "borderRadius": 24,
                                "fontSize": 40
                            }
                        },
                        {
                            "condition": "",
                            "value": {
                                "padding": 10
                            }
                        }
                    ]
                }
            ]
        }
    ]
}
