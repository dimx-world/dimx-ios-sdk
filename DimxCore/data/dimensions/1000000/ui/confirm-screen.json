 {
    "_comment": "The engine's confirmation (AppConfirmScreen). On a phone it is 900 points of the screen's 1000 wide, its text and buttons at sizes a finger can use; the desktop keeps the small dialog.",
    "name": "confirm-screen",
    "type": "Window",
    "visible": false,
    "closeButton": false,
    "?style": [
        {
            "condition": {"type": "platform", "value": "Mobile"},
            "value": {
                "margin": "auto",
                "width": 900,
                "flexDirection": "column",
                "alignItems": "stretch",
                "gap": 24,
                "padding": 30,
                "fontSize": 40
            }
        },
        {
            "condition": "",
            "value": {
                "margin": "auto",
                "width": 500,
                "flexDirection": "column",
                "alignItems": "stretch",
                "padding": 20
            }
        }
    ],
    "modal": true,
    "text": "Confirm",
    "children": [
        {
            "name": "details",
            "type": "Text",
            "text": "Are you sure you want to proceed?",
            "?style": [
                {
                    "condition": {"type": "platform", "value": "Mobile"},
                    "value": {
                        "width": "100%",
                        "fontSize": 34
                    }
                },
                {
                    "condition": "",
                    "value": {
                        "margin": 20
                    }
                }
            ]
        },
        {
            "name": "button-container",
            "?style": [
                {
                    "condition": {"type": "platform", "value": "Mobile"},
                    "value": {
                        "flexDirection": "row",
                        "gap": 30,
                        "width": "100%",
                        "marginTop": 10
                    }
                },
                {
                    "condition": "",
                    "value": {
                        "flexDirection": "row",
                        "justifyContent": "center",
                        "gap": 50,
                        "width": "100%",
                        "marginBottom": 20
                    }
                }
            ],
            "children": [
                {
                    "name": "ok-btn",
                    "type": "Button",
                    "text": "OK",
                    "?style": [
                        {
                            "condition": {"type": "platform", "value": "Mobile"},
                            "value": {
                                "height": 120,
                                "flexGrow": 1,
                                "flexBasis": 0,
                                "borderRadius": 24,
                                "fontSize": 40
                            }
                        },
                        {
                            "condition": "",
                            "value": {
                                "padding": 10
                            }
                        }
                    ]
                },
                {
                    "name": "cancel-btn",
                    "type": "Button",
                    "text": "Cancel",
                    "?style": [
                        {
                            "condition": {"type": "platform", "value": "Mobile"},
                            "value": {
                                "height": 120,
                                "flexGrow": 1,
                                "flexBasis": 0,
                                "borderRadius": 24,
                                "fontSize": 40
                            }
                        },
                        {
                            "condition": "",
                            "value": {
                                "padding": 10
                            }
                        }
                    ]
                }
            ]
        }
    ]
}
