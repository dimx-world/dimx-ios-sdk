{
    "name": "right-panel",
    "type": "Window",
    "panel": true,
    "style": {
        "marginLeft": "auto",
        "marginRight": 0,
        "marginTop": 250,
        "marginBottom": "auto",
        "width": 170,
        "backgroundColor": [0, 0, 0, 0]
    },
    "children": [
        {
            "name": "list-container",
            "style": {
                "width": "100%",
                "height": "100%",
                "_overflow": "scroll",
                "flexDirection": "column",
                "alignItems": "center"
            },
            "custom": {
                "itemTemplate": {
                    "type": "Element",
                    "style": {
                        "width": 150,
                        "height": 150,
                        "marginBottom": 10,
                        "flexShrink": 0
                    },
                    "children": [
                        {
                            "name": "dimension-btn",
                            "type": "Button",
                            "classNames": [ "no-frame" ],
                            "style": {
                                "left": 0,
                                "top": 0,
                                "width": 150,
                                "height": 150
                            }
                        },
                        {
                            "name": "dimension-load",
                            "type": "LoadingIndicator",
                            "style": {
                                "left": 30,
                                "top": 30,
                                "width": 90,
                                "height": 90,
                                "color": [1, 1, 1, 1]
                            }
                        },
                        {
                            "name": "dimension-active-locs-txt",
                            "type": "Text",
                            "text": "0",
                            "visible": false,
                            "style": {
                                "left": 100,
                                "top": 120,
                                "width": 40,
                                "color": [0, 1, 0, 1],
                                "textAlign": "right"
                            }
                        },
                        {
                            "name": "dimension-not-tracked-locs-txt",
                            "type": "Text",
                            "text": "0",
                            "visible": false,
                            "style": {
                                "left": 50,
                                "top": 120,
                                "width": 50,
                                "color": [1, 1, 0, 1],
                                "textAlign": "center"
                            }
                        },
                        {
                            "name": "dimension-pending-locs-txt",
                            "type": "Text",
                            "text": "0",
                            "visible": false,
                            "style": {
                                "left": 10,
                                "top": 120,
                                "width": 40,
                                "color": [1, 1, 1, 1],
                                "textAlign": "left"
                            }
                        }
                    ]
                }
            }
        }
    ]
}
