                                    { "condition": {"type": "platform", "value": "Mobile"}, "value": 44 },
                                    { "condition": "", "value": 22 }
                                ]
                            }
                        },
                        {
                            "name": "map-text",
                            "type": "Text",
                            "text": "Map -"
                        }
                    ]
                },
                {
                    "name": "map-detail-text",
                    "type": "Text",
